#!/usr/bin/env python3
"""AI review of a GitHub pull request or a GitLab merge request, through crenya ai (api.crenya.ai).
Installed on crenya-ci as /usr/local/bin/crenya-ai-review. Stdlib only. Grew out of crenya/crenya
scripts/ai_review.py (GitHub only); this one serves every repo on both platforms.

GitHub Actions:  crenya-ai-review --github --pr 12      env: GH_TOKEN, GITHUB_REPOSITORY
GitLab CI:       crenya-ai-review --gitlab               env: GITLAB_REVIEW_TOKEN, CI_PROJECT_ID,
                                                              CI_MERGE_REQUEST_IID, CI_SERVER_URL
Both:            env CRENYA_AI_TOKEN (crenya ai key). Optional CRENYA_AI_MODEL, CRENYA_AI_BASE_URL.

GitHub: also sets the commit status "crenya ai review" on the PR head — success (no HIGH), failure (a HIGH
finding) or error (no verdict) — which copilot's auto-merge reads as its review condition.
Exit 0 = review posted (or nothing to say). With --block-on-high, a review that reports a HIGH finding
exits 1 so the pipeline goes red. A broken reviewer (gateway down, no token) never blocks: it prints
why and exits 0, because a missing review must not stop a merge the tests already passed.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys
import urllib.error
import urllib.parse
import urllib.request

MAX_DIFF_CHARS = 60_000
MAX_FILES = 40
TIMEOUT = 180

SYSTEM_PROMPT = """You are a senior engineer reviewing a change before it merges.
Report only defects a reviewer would block on:
- bugs and incorrect logic
- security problems (secrets in code, injection, missing permission checks, unsafe deserialization)
- Frappe pitfalls: frappe.db / get_all calls that skip permissions on user input, whitelisted methods
  without a role or permission check, schema changes without a patch, ignore_permissions on user data
- resource or performance regressions, broken error handling
- missing or wrong tests for the changed behaviour
Settled setup (not a finding): these are private repositories with internal contributors only; their CI runs on
crenya-ci, a box dedicated to CI (`runs-on: [self-hosted, crenya-ci]`), with per-repo secrets, and this review
runs there too. Moving a job to that runner, or the review job skipping fork PRs, is the intended design.
That someone with push access could edit a workflow on a branch and reach its secrets is true of every
workflow in these repositories and is the accepted trust model, not a finding about the diff.
House rules (report a breach as MEDIUM): the brand is written lowercase ("crenya", "crenya ai");
no AI-assistant identity in code, comments or commit text (no "Co-Authored-By", no "Generated with").

Format each finding as one bullet:
- **HIGH|MEDIUM|LOW** `path:line` — what is wrong and why it matters.
Severity — HIGH blocks the merge, so it must be earned:
- HIGH = a concrete defect this diff INTRODUCES that would cause data loss, an exploitable security hole,
  or production breakage as written. You must be able to state the input or event that triggers it.
- Hypotheticals ("if this later…", "if the script ever…"), hardening suggestions, patterns that were
  already there before this diff, and defence-in-depth ideas are MEDIUM at most.
Cite file and line for every finding.
Do not restate the diff, do not praise, do not suggest stylistic rewrites.
If there is no blocking defect, reply with exactly: NO_BLOCKING_ISSUES
Keep the review under 400 words."""


# A 502/503/504 or a dropped connection from GitHub/GitLab is their hiccup, not a review result: it
# failed crenya_pos_api #54 on 2026-11-04 while posting the review. Retry with backoff; a 4xx (bad
# token, missing PR) still fails at once. A retried POST can leave a duplicate comment if the first
# one landed despite the 5xx — better than a red check that blocks the merge for nothing.
RETRY_STATUS = {500, 502, 503, 504}
RETRY_WAITS = (5, 15, 45)


def _sleep(seconds: float) -> None:  # tests replace this
    import time

    time.sleep(seconds)


def http(url: str, headers: dict, data: dict | None = None, method: str = "GET", raw: bool = False):
    body = json.dumps(data).encode() if data is not None else None
    for attempt in range(len(RETRY_WAITS) + 1):
        req = urllib.request.Request(url, data=body, method=method)
        for k, v in headers.items():
            req.add_header(k, v)
        if body is not None:
            req.add_header("Content-Type", "application/json")
        try:
            with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
                payload = resp.read()
            break
        except urllib.error.HTTPError as e:
            if e.code not in RETRY_STATUS or attempt == len(RETRY_WAITS):
                raise
            print(f"crenya-ai-review: {method} {url} -> {e.code}, retrying", file=sys.stderr)
        except (urllib.error.URLError, TimeoutError, ConnectionError) as e:
            if attempt == len(RETRY_WAITS):
                raise
            print(f"crenya-ai-review: {method} {url} -> {e}, retrying", file=sys.stderr)
        _sleep(RETRY_WAITS[attempt])
    if raw:
        return payload.decode("utf-8", "replace")
    return json.loads(payload) if payload else {}


# --- GitHub
STATUS = "crenya ai review"  # the commit status copilot's auto-merge reads (crenya_copilot ops/automerge.ts)


def gh_head(repo: str, pr: int, token: str) -> str:
    return http(f"https://api.github.com/repos/{repo}/pulls/{pr}",
                {"Authorization": f"Bearer {token}", "Accept": "application/vnd.github+json"})["head"]["sha"]


def gh_status(repo: str, sha: str, token: str, state: str, text: str) -> None:
    """success = no HIGH finding (auto-merge may proceed); failure = a HIGH finding; error = no verdict."""
    try:
        http(f"https://api.github.com/repos/{repo}/statuses/{sha}",
             {"Authorization": f"Bearer {token}", "Accept": "application/vnd.github+json"},
             {"state": state, "context": STATUS, "description": text[:140]}, "POST")
    except urllib.error.URLError as exc:
        print(f"crenya-ai-review: could not set the {STATUS} status ({exc!r})")


def gh_diff(repo: str, pr: int, token: str) -> str:
    return http(f"https://api.github.com/repos/{repo}/pulls/{pr}",
                {"Authorization": f"Bearer {token}", "Accept": "application/vnd.github.v3.diff"}, raw=True)


def gh_post(repo: str, pr: int, token: str, text: str) -> str:
    r = http(f"https://api.github.com/repos/{repo}/pulls/{pr}/reviews",
             {"Authorization": f"Bearer {token}", "Accept": "application/vnd.github+json"},
             {"body": text, "event": "COMMENT"}, "POST")
    return r.get("html_url", "")


# House rule: no AI tool identity in our pull requests or history (founder 10-29). The PR body's attribution line is
# removed here; a commit trailer cannot be, so it is a HIGH (amend the commit).
AI_BODY = re.compile(r"\n*[^\n]*Generated with \[?Claude Code\]?(\([^)]*\))?[^\n]*", re.I)
AI_TRAILER = re.compile(r"^Co-Authored-By:\s*Claude\b.*$", re.I | re.M)


def gh_attribution(repo: str, pr: int, token: str, dry: bool) -> list[str]:
    h = {"Authorization": f"Bearer {token}", "Accept": "application/vnd.github+json"}
    out = []
    body = http(f"https://api.github.com/repos/{repo}/pulls/{pr}", h).get("body") or ""
    clean = AI_BODY.sub("", body).rstrip()
    if clean != body.rstrip():
        if not dry:
            http(f"https://api.github.com/repos/{repo}/pulls/{pr}", h, {"body": clean + "\n"}, "PATCH")
        print("crenya-ai-review: removed the AI attribution line from the PR description")
    commits = http(f"https://api.github.com/repos/{repo}/pulls/{pr}/commits?per_page=100", h)
    bad = [c["sha"][:7] for c in commits if AI_TRAILER.search(c["commit"]["message"])]
    if bad:
        out.append(f"- **HIGH** commit message — `Co-Authored-By: Claude` in {', '.join(bad)}: no AI tool identity in "
                   "our history (house rule). Remove the trailer (`git commit --amend` / rebase) and force-push.")
    return out


# --- GitLab
def gl_diff(api: str, project: str, iid: str, token: str) -> str:
    h = {"PRIVATE-TOKEN": token}
    parts, page = [], 1
    while True:
        rows = http(f"{api}/projects/{project}/merge_requests/{iid}/diffs?per_page=50&page={page}", h)
        if not rows:
            break
        for d in rows:
            parts.append(f"diff --git a/{d['old_path']} b/{d['new_path']}\n{d.get('diff', '')}")
        page += 1
    return "\n".join(parts)


FOUNDER_GITLAB = "sammish"  # auto-merge only ever takes the founder's own MRs (same rule as copilot on GitHub)


def gl_automerge(api: str, project: str, iid: str, token: str) -> str:
    """Ask GitLab to merge this MR when its pipeline succeeds. Only for the founder's own, non-draft MR
    from this same project; GitLab itself then waits for every job (tests + this review) to pass."""
    h = {"PRIVATE-TOKEN": token}
    mr = http(f"{api}/projects/{project}/merge_requests/{iid}", h)
    if mr.get("draft") or mr.get("work_in_progress"):
        return "draft: not auto-merged"
    if (mr.get("author") or {}).get("username") != FOUNDER_GITLAB:
        return f"author {(mr.get('author') or {}).get('username')}: not auto-merged"
    if mr.get("source_project_id") != mr.get("target_project_id"):
        return "from another project: not auto-merged"
    if "hold" in (mr.get("labels") or []):
        return "labelled hold: not auto-merged"
    http(f"{api}/projects/{project}/merge_requests/{iid}/merge", h,
         {"merge_when_pipeline_succeeds": True, "auto_merge": True, "sha": mr["sha"]}, "PUT")
    return "auto-merge set: GitLab merges when the pipeline succeeds"


def gl_post(api: str, project: str, iid: str, token: str, text: str) -> str:
    r = http(f"{api}/projects/{project}/merge_requests/{iid}/notes", {"PRIVATE-TOKEN": token},
             {"body": text}, "POST")
    return str(r.get("id", ""))


# A HIGH must name what triggers it (SYSTEM_PROMPT); one that asks the author to confirm or verify, or says the
# defect might happen, is a hypothesis, and a hypothesis is MEDIUM at most. Enforced here because the model does not
# always keep that rule (10-28: two "Confirm…"/"Verify…" HIGHs on code that was right blocked an auto-merge).
UNPROVEN = re.compile(
    r"\b(confirm|verify|worth (checking|confirming)|might|could|if any|presumably"
    r"|is (a|only a) (MEDIUM|LOW)|not a (stated |real )?HIGH|no defect)\b",  # a HIGH that argues itself down
    re.I,
)


def demote_unproven(text: str) -> str:
    out = []
    for line in text.split("\n"):
        if "**HIGH**" in line and UNPROVEN.search(line):
            line = line.replace("**HIGH**", "**MEDIUM**", 1) + " _(unproven: demoted from HIGH)_"
        out.append(line)
    return "\n".join(out)


CONFIRM_PROMPT = """You check one finding from a code review before it blocks a merge. Try to REFUTE it.
Read the diff. The finding stands only if you can name the exact input or state, in this diff's code as written,
that produces the wrong result, crash or security hole it claims. If the code already handles it, if the claim
misreads the code (a regex, a guard a few lines away, a branch that cannot be reached), or if it is a style or
robustness wish rather than a defect, it is refuted.
Answer with ONE line and nothing else:
CONFIRMED: <the concrete trigger>
REFUTED: <why, in one sentence>"""


def confirm_highs(text: str, check) -> str:
    """Each model HIGH gets a second, adversarial look (`check(finding) -> reply`); only a CONFIRMED one stays
    HIGH. 10-30: on crenya_ci #17-#19 the review raised a new HIGH on every push, most of them misreadings
    (a regex that "never matches" and does), and each one blocked copilot's auto-merge. A check that fails or
    answers anything else keeps the HIGH: an unconfirmed second look must not open the merge."""
    out = []
    for line in text.split("\n"):
        if "**HIGH**" in line:
            try:
                reply = check(line).strip().splitlines()[0].strip() if check else ""
            except Exception:  # noqa: BLE001 -- no verdict keeps the HIGH
                reply = ""
            if reply.upper().startswith("REFUTED"):
                why = reply.split(":", 1)[1].strip() if ":" in reply else ""
                line = line.replace("**HIGH**", "**MEDIUM**", 1) + f" _(not confirmed on a second look: {why})_"
        out.append(line)
    return "\n".join(out)


def ask(base_url: str, model: str, token: str, diff: str) -> str:
    if len(diff) > MAX_DIFF_CHARS:
        diff = diff[:MAX_DIFF_CHARS] + "\n\n[diff truncated]\n"
    data = http(base_url.rstrip("/") + "/chat/completions", {"Authorization": f"Bearer {token}"}, {
        "model": model, "temperature": 0, "max_tokens": 1200,
        "messages": [{"role": "system", "content": SYSTEM_PROMPT},
                     {"role": "user", "content": f"Review this diff:\n\n```diff\n{diff}\n```"}],
    }, "POST")
    return data["choices"][0]["message"]["content"].strip()


GENERATED = re.compile(r"(^|/)(package-lock\.json|yarn\.lock|pnpm-lock\.yaml|bun\.lockb?|Cargo\.lock|poetry\.lock|"
                       r"uv\.lock|go\.sum|composer\.lock)$|\.min\.(js|css)$|(^|/)(dist|build|vendor|node_modules)/")
MAX_BATCHES = 8


def split_files(diff: str) -> list:
    """The diff as [(path, section)], one per file; lockfiles and generated output left out (nobody reviews those
    line by line, and they made big PRs 'too large to review' - erptrue_web!93, 11-07)."""
    out = []
    for sec in re.split(r"(?m)^(?=diff --git )", diff):
        m = re.match(r"diff --git a/(\S+) b/(\S+)", sec)
        if m and not GENERATED.search(m.group(2)):
            out.append((m.group(2), sec))
    return out


def batches(files: list, limit: int = MAX_DIFF_CHARS, max_files: int = MAX_FILES) -> list:
    """Whole files packed in order into batches under `limit` chars and `max_files` files; a single file larger than
    `limit` is cut (its head is what can be read)."""
    out, cur, size = [], [], 0
    for path, sec in files:
        if len(sec) > limit:
            sec = sec[:limit] + "\n[file diff truncated]\n"
        if cur and (size + len(sec) > limit or len(cur) >= max_files):
            out.append(cur)
            cur, size = [], 0
        cur.append((path, sec))
        size += len(sec)
    if cur:
        out.append(cur)
    return out


def main() -> int:
    p = argparse.ArgumentParser()
    g = p.add_mutually_exclusive_group(required=True)
    g.add_argument("--github", action="store_true")
    g.add_argument("--gitlab", action="store_true")
    p.add_argument("--pr", type=int)
    p.add_argument("--base-url", default=os.environ.get("CRENYA_AI_BASE_URL", "https://api.crenya.ai/v1"))
    p.add_argument("--model", default=os.environ.get("CRENYA_AI_MODEL", "crenya-economy"))
    p.add_argument("--block-on-high", action="store_true")
    p.add_argument("--automerge", action="store_true", help="GitLab: set merge-when-pipeline-succeeds when no HIGH")
    p.add_argument("--dry-run", action="store_true")
    a = p.parse_args()

    ai_token = os.environ.get("CRENYA_AI_TOKEN")
    if not ai_token:
        print("crenya-ai-review: CRENYA_AI_TOKEN not set — skipping review")
        return 0
    sha, house = "", []
    try:
        if a.github:
            repo, tok = os.environ["GITHUB_REPOSITORY"], os.environ["GH_TOKEN"]
            sha = gh_head(repo, a.pr, tok)
            if not a.dry_run:
                gh_status(repo, sha, tok, "pending", "reviewing")
            diff = gh_diff(repo, a.pr, tok)
            house = gh_attribution(repo, a.pr, tok, a.dry_run)
        else:
            api = os.environ.get("CI_SERVER_URL", "https://gitlab.com").rstrip("/") + "/api/v4"
            project = urllib.parse.quote(os.environ["CI_PROJECT_ID"], safe="")
            iid, tok = os.environ["CI_MERGE_REQUEST_IID"], os.environ["GITLAB_REVIEW_TOKEN"]
            diff = gl_diff(api, project, iid, tok)
        files = split_files(diff)
        if not files:
            print("crenya-ai-review: only generated files or no changes — nothing to review")
            if sha and not a.dry_run:
                gh_status(repo, sha, tok, "success", "no reviewable changes (lockfiles / generated only)")
            if a.gitlab and a.automerge and not a.dry_run:
                print("crenya-ai-review:", gl_automerge(api, project, iid, tok))
            return 0
        groups = batches(files)
        skipped = [p for g in groups[MAX_BATCHES:] for p, _ in g]
        groups = groups[:MAX_BATCHES]
        if len(groups) > 1 or skipped:
            print(f"crenya-ai-review: {len(files)} files in {len(groups)} batches" + (f", {len(skipped)} not reviewed" if skipped else ""))
        parts = []
        for g in groups:
            chunk = "".join(sec for _, sec in g)
            t = demote_unproven(ask(a.base_url, a.model, ai_token, chunk))
            if "**HIGH**" in t:
                def check(finding: str, chunk=chunk) -> str:
                    data = http(a.base_url.rstrip("/") + "/chat/completions", {"Authorization": f"Bearer {ai_token}"}, {
                        "model": a.model, "temperature": 0, "max_tokens": 200,
                        "messages": [{"role": "system", "content": CONFIRM_PROMPT},
                                     {"role": "user", "content": f"Finding:\n{finding}\n\nDiff:\n```diff\n{chunk}\n```"}],
                    }, "POST")
                    return data["choices"][0]["message"]["content"]
                t = confirm_highs(t, check)
            if t.strip() != "NO_BLOCKING_ISSUES":
                parts.append(t.strip())
        if skipped:
            # on the review surface (the PR / MR comment and the status), not only in the CI log
            note = (f"**Not reviewed** ({len(skipped)} files beyond {MAX_BATCHES} batches): "
                    f"{', '.join(skipped[:20])}{' …' if len(skipped) > 20 else ''}")
            parts.append(note)
            print("crenya-ai-review:", note)
        text = "\n\n".join(parts) if parts else "NO_BLOCKING_ISSUES"
    except (KeyError, urllib.error.URLError, TimeoutError, ValueError) as exc:
        detail = exc.read().decode("utf-8", "replace")[:300] if isinstance(exc, urllib.error.HTTPError) else ""
        print(f"crenya-ai-review: could not review ({exc!r}) {detail}")
        if sha and not a.dry_run:
            gh_status(repo, sha, tok, "error", "the review could not run: merge by hand")
        return 0

    if a.github and house:  # the house rule is checked here, not by the model
        text = "\n".join(house) + ("" if text == "NO_BLOCKING_ISSUES" else "\n" + text)
    high = text != "NO_BLOCKING_ISSUES" and bool(re.search(r"\*\*HIGH\*\*", text))
    if a.gitlab and a.automerge and not high and not a.dry_run:
        try:
            print("crenya-ai-review:", gl_automerge(api, project, iid, tok))
        except urllib.error.URLError as exc:
            print(f"crenya-ai-review: could not set auto-merge ({exc!r})")
    if text == "NO_BLOCKING_ISSUES":
        print("crenya-ai-review: no blocking issues")
        if sha and not a.dry_run:
            gh_status(repo, sha, tok, "success", "no blocking issues")
        return 0
    body = f"### crenya ai review (`{a.model}`)\n\n{text}\n\n_Automated review._"
    if a.dry_run:
        print(body)
    else:
        where = gh_post(repo, a.pr, tok, body) if a.github else gl_post(api, project, iid, tok, body)
        print(f"crenya-ai-review: posted {where}")
        if sha:
            not_reviewed = f"; {text.split('**Not reviewed** (', 1)[1].split(' ', 1)[0]} files not reviewed" if "**Not reviewed** (" in text else ""
            gh_status(repo, sha, tok, "failure" if high else "success",
                      ("a HIGH finding: fix it or merge by hand" if high else "findings below HIGH only") + not_reviewed)
    if high and a.block_on_high:
        print("crenya-ai-review: HIGH finding — failing this check (merge stays possible by override)")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
